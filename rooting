1 "/"(root)にアクセスすると、{"message": "Hai"}と返される

func main() {
	router := gin.Default()

	// "/" ルートにアクセスすると {"message": "Hai"} を返す
	router.GET("/", func(c *gin.Context) {
		c.JSON(http.StatusOK, gin.H{"message": "Hai"})
	})

